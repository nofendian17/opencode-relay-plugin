  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "files": [
    "index.ts",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "relay",
    "proxy"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/relay.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.24",
    "@types/node": "^26.6.4",
    "typescript": "^5.9.3"
  }
}
